PGDATA_DIR=
# Generation backend. Default is offline (deterministic templates, no network).
# LLM_PROVIDER=offline
# To route template misses to a model instead of the clarify path:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Or: LLM_PROVIDER=gemini
# GOOGLE_API_KEY=...
# LLM_MODEL=gemini-2.5-flash
# LLM_FALLBACK_MODEL=gemini-2.5-flash-lite
# LLM_MIN_INTERVAL_MS=8000
